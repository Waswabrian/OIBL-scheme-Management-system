<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Convert Prospect</title>

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body{
            background:#f4f6f9;
            font-family:'Segoe UI',sans-serif;
            overflow-x:hidden;
        }

        .main-content{
            margin-left:280px;
            padding:30px;
            min-height:100vh;
        }

        .page-header{
            background:#fff;
            padding:25px 30px;
            border-radius:18px;
            margin-bottom:25px;
            box-shadow:0 4px 15px rgba(0,0,0,.05);
        }

        .page-header h2{
            font-weight:700;
            margin-bottom:5px;
        }

        .card{
            border:none;
            border-radius:18px;
            box-shadow:0 4px 15px rgba(0,0,0,.05);
        }

        .card-header{
            background:linear-gradient(
                135deg,
                #16a34a,
                #22c55e
            );
            color:white;
            border:none;
            padding:18px 25px;
        }

        .card-body{
            padding:30px;
        }

        .form-label{
            font-weight:600;
            color:#374151;
        }

        .form-control{
            border-radius:12px;
            min-height:48px;
        }

        textarea.form-control{
            min-height:120px;
        }

        .btn{
            border-radius:12px;
            font-weight:600;
        }

        @media(max-width:992px){

            .main-content{
                margin-left:0;
                padding:15px;
            }

        }

    </style>
</head>

<body>

    <%- include('../partials/bdo_sidebar') %>

    <div class="main-content">

        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h2>
                        <i class="bi bi-arrow-repeat text-success"></i>
                        Convert Prospect
                    </h2>
                    <p class="text-muted mb-0">
                        Convert a prospect into a scheme
                    </p>
                </div>

                <a href="/bdo/prospects" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back to Prospects
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Prospect Details</h4>
            </div>

            <div class="card-body">
                <h5>Prospect ID: <%= prospectId %></h5>

                <form action="/bdo/schemes/create/<%= prospectId %>" method="POST">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Scheme Name</label>
                            <input
                                type="text"
                                name="scheme_name"
                                class="form-control"
                                value="<%= prospect && prospect.company_name ? prospect.company_name : '' %>"
                                required
                            >
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contact Person</label>
                            <input
                                type="text"
                                name="contact_person"
                                class="form-control"
                                value="<%= prospect && prospect.contact_person ? prospect.contact_person : '' %>"
                            >
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone Number</label>
                            <input
                                type="text"
                                name="phone"
                                class="form-control"
                                value="<%= prospect && prospect.phone ? prospect.phone : '' %>"
                            >
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email Address</label>
                            <input
                                type="email"
                                name="email"
                                class="form-control"
                                value="<%= prospect && prospect.email ? prospect.email : '' %>"
                            >
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Insurer</label>
                            <input type="text" name="insurer" class="form-control" placeholder="e.g. Jubilee Insurance">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Policy Type</label>
                            <input
                                type="text"
                                name="policy_type"
                                class="form-control"
                                value="Medical Insurance"
                            >
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Premium</label>
                            <input
                                type="number"
                                name="premium"
                                class="form-control"
                                value="<%= prospect && prospect.estimated_premium ? prospect.estimated_premium : 0 %>"
                                min="0"
                                step="0.01"
                            >
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-control">
                                <option value="Onboarding">Onboarding</option>
                                <option value="Active">Active</option>
                                <option value="Pending_Renewal">Pending Renewal</option>
                                <option value="Renewed">Renewed</option>
                                <option value="Lost">Lost</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Conversion Notes</label>
                        <textarea class="form-control" name="notes" rows="4"></textarea>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" onclick="window.location.href='/bdo/prospects'">
                            <i class="bi bi-x-circle"></i>
                            Cancel
                        </button>

                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i>
                            Convert Prospect
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>

</body>
</html>
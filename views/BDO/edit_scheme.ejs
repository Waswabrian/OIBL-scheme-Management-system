<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Business</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
    <style>
        body {
            background-color: #f8f9fa;
        }

        .page-header {
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            color: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .card {
            border: none;
            border-radius: 12px;
        }

        .required {
            color: red;
        }
    </style>
</head>
<body>

<div class="container py-5">

    <div class="page-header shadow">
        <h2 class="mb-1">Edit Business</h2>
        <p class="mb-0">Update business information and save changes.</p>
    </div>

    <div class="card shadow">
        <div class="card-body">

            <form action="/bdo/schemes/update/<%= scheme.scheme_id %>" method="POST">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Business Name <span class="required">*</span>
                        </label>
                        <input
                            type="text"
                            name="scheme_name"
                            class="form-control"
                            value="<%= scheme.scheme_name %>"
                            required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Company Name <span class="required">*</span>
                        </label>
                        <input
                            type="text"
                            name="company_name"
                            class="form-control"
                            value="<%= scheme.company_name %>"
                            required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Product Type
                        </label>
                        <input
                            type="text"
                            name="product_type"
                            class="form-control"
                            value="<%= scheme.product_type || '' %>">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Annual Premium
                        </label>
                        <input
                            type="number"
                            step="0.01"
                            name="annual_premium"
                            class="form-control"
                            value="<%= scheme.annual_premium || '' %>">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                           Date of Commencement
                        </label>
                        <input
                            type="date"
                            name="commencement_date"
                            class="form-control"
                            value="<%= scheme.commencement_date ? new Date(scheme.commencement_date).toISOString().split('T')[0] : '' %>">
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">
                            Remarks
                        </label>
                        <textarea
                            name="remarks"
                            rows="4"
                            class="form-control"><%= scheme.remarks || '' %></textarea>
                    </div>

                </div>

                <div class="d-flex justify-content-between">
                    <a href="/bdo/schemes" class="btn btn-secondary">
                       Back         
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

</body>
</html>
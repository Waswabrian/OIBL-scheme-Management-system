<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BDO Reports Dashboard</title>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css  ">
<style>
.main-content{
    margin-left:320px;
    padding:30px;
}

body{
    background:#f4f7fc;
}

.page-wrapper{
    display:flex;
}

.main-content{
    flex:1;
    margin-left:260px;
    padding:30px;
}

.page-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
}

.page-header h1{
    color:#123d6b;
    font-size:32px;
    font-weight:700;
}

.page-header p{
    color:#6c757d;
}

.export-btn{
    background:#f7941d;
    color:white;
    padding:12px 20px;
    border-radius:8px;
    text-decoration:none;
    font-weight:600;
}

.export-btn:hover{
    background:#e6830f;
}

.stats-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-bottom:30px;
}

.stat-card{
    background:white;
    border-radius:12px;
    padding:25px;
    box-shadow:0 5px 15px rgba(0,0,0,.08);
    border-left:5px solid #123d6b;
}

.stat-card i{
    font-size:30px;
    color:#123d6b;
}

.stat-card h4{
    margin-top:10px;
    color:#64748b;
    font-size:14px;
}

.stat-card h2{
    margin-top:10px;
    color:#123d6b;
}

.report-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    margin-bottom:30px;
}

.report-card{
    background:white;
    padding:25px;
    border-radius:12px;
    text-decoration:none;
    color:#333;
    box-shadow:0 3px 12px rgba(0,0,0,.08);
    transition:.3s;
}

.report-card:hover{
    transform:translateY(-5px);
}

.report-card i{
    font-size:35px;
    color:#123d6b;
}

.report-card h3{
    margin-top:15px;
    margin-bottom:10px;
}

.report-card p{
    color:#6c757d;
}

.table-card{
    background:white;
    border-radius:12px;
    padding:25px;
    box-shadow:0 3px 12px rgba(0,0,0,.08);
}

.table-card h2{
    margin-bottom:20px;
    color:#123d6b;
}

table{
    width:100%;
    border-collapse:collapse;
}

thead{
    background:#123d6b;
    color:white;
}

th,td{
    padding:14px;
    text-align:left;
}

tbody tr{
    border-bottom:1px solid #eee;
}

.badge{
    display:inline-block;
    background:#dbeafe;
    color:#1e40af;
    padding:6px 12px;
    border-radius:20px;
    font-size:12px;
    font-weight:600;
}

.won{
    background:#dcfce7;
    color:#166534;
}

</style>
</head>

<body>

<%- include('../partials/bdo_nav') %>
<div class="page-wrapper">

    <%- include('../partials/bdo_sidebar') %>

    <div class="main-content">

        <div class="page-header">
            <div>
                <h1>Reports Dashboard</h1>
                <p>Business Development Performance & Reporting</p>
            </div>
            <a class="export-btn" href="/bdo/reports/export-excel">
                <i class="bi bi-download"></i>
                Export Report
            </a>
        </div>

        <!-- KPI Cards -->

        <div class="stats-grid">

            <div class="stat-card">
                <i class="bi bi-folder2-open"></i>
                <h4>Total Schemes</h4>
                <h2><%= schemes.length %></h2>
            </div>

            <div class="stat-card">
                <i class="bi bi-people-fill"></i>
                <h4>Total Prospects</h4>
                <h2><%= prospects.length %></h2>
            </div>

            <div class="stat-card">
                <i class="bi bi-arrow-repeat"></i>
                <h4>Follow Ups</h4>
                <h2><%= followups.length %></h2>
            </div>

            <div class="stat-card">
                <i class="bi bi-trophy-fill"></i>
                <h4>Won Opportunities</h4>
                <h2><%= wonSchemes || 0 %></h2>
            </div>

        </div>

        <!-- Reports -->

        <div class="report-grid">

            <a href="/bdo/reports/schemes">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <h3>Scheme Report</h3>
                <p>View all scheme performance reports.</p>
            </a>
            <a href="/bdo/reports/prospects">
                <i class="bi bi-person-lines-fill"></i>
                <h3>Prospects Report</h3>
                <p>Track prospect pipeline and conversion.</p>
            </a>

            <a href="/bdo/reports/followups">
                <i class="bi bi-calendar-check"></i>
                <h3>Follow Ups</h3>
                <p>All follow up activities and schedules.</p>
            </a>

            <a href="/bdo/reports/export-excel">
                <i class="bi bi-file-earmark-excel"></i>
                <h3>Excel Export</h3>
                <p>Download complete BDO reports.</p>
            </a>

        </div>

        <!-- Recent Schemes -->

        <div class="table-card">

            <h2>Recent Schemes</h2>

            <table>

                <thead>
                <tr>
                    <th>Scheme</th>
                    <th>Insurer</th>
                    <th>Status</th>
                    <th>Premium</th>
                </tr>
                </thead>

                <tbody>

                <% schemes.forEach(scheme => { %>

                <tr>

                    <td>
                        <%= scheme.scheme_name %>
                    </td>

                    <td>
                        <%= scheme.insurer || '-' %>
                    </td>

                    <td>

                        <% if(String(scheme.stage).toLowerCase() === 'won'){ %>

                            <span class="badge won">
                                Won
                            </span>

                        <% } else { %>

                            <span class="badge">
                                <%= scheme.stage || 'Open' %>
                            </span>

                        <% } %>

                    </td>

                    <td>
                        KES <%= Number(scheme.estimated_premium || scheme.premium || 0).toLocaleString() %>
                    </td>

                </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

</body>
</html>
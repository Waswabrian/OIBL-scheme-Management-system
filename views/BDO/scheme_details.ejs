<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Details</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body{
            background: #f4f6f9;
        }

        .card{
            border:none;
            border-radius:12px;
        }

        .status-pill{
            font-size:14px;
            padding:8px 12px;
        }

        .timeline{
            border-left:3px solid #dee2e6;
            padding-left:20px;
        }

        .timeline-item{
            position:relative;
            margin-bottom:25px;
        }

        .timeline-item::before{
            content:'';
            position:absolute;
            left:-28px;
            top:4px;
            width:14px;
            height:14px;
            border-radius:50%;
            background:#0d6efd;
        }
    </style>
</head>
<body>

<div class="container-fluid py-4">

    <!-- Header -->
     <!-- <%- include('../partials/bdo_nav') %> -->
    <%- include('../partials/bdo_sidebar') %>
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Business Details</h2>
            <p class="text-muted">
                Business Number: <strong><%= scheme.scheme_no %></strong>
            </p>
        </div>

        <div>
            <a href="/bdo/schemes" class="btn btn-secondary">
                Back
            </a>

            <button class="btn btn-primary">
                Print Summary
            </button>

        </div>

    </div>

    <div class="row">

        <!-- Scheme Details -->

        <div class="col-md-8">

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Business    Information</strong>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <strong>Business Name</strong>
                            <p><%= scheme.scheme_name %></p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Product Type</strong>
                            <p><%= scheme.product_type %></p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Client</strong>
                            <p><%= scheme.company_name %></p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Status</strong>

                            <p>

                            <% if(scheme.status === "Draft"){ %>
                                <span class="badge bg-secondary status-pill">
                                    Draft
                                </span>
                            <% } %>

                            <% if(scheme.status === "Submitted"){ %>
                                <span class="badge bg-primary status-pill">
                                    Submitted
                                </span>
                            <% } %>

                            <% if(scheme.status === "Under Review"){ %>
                                <span class="badge bg-warning text-dark status-pill">
                                    Under Review
                                </span>
                            <% } %>

                            <% if(scheme.status === "Approved"){ %>
                                <span class="badge bg-success status-pill">
                                    Approved
                                </span>
                            <% } %>

                            <% if(scheme.status === "Rejected"){ %>
                                <span class="badge bg-danger status-pill">
                                    Rejected
                                </span>
                            <% } %>

                            <% if(scheme.status === "Activated"){ %>
                                <span class="badge bg-dark status-pill">
                                    Activated
                                </span>
                            <% } %>

                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Membership -->

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Membership Details</strong>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">
                            <strong>Principal Members</strong>
                            <p><%= scheme.principal_members %></p>
                        </div>

                        <div class="col-md-4">
                            <strong>Dependants</strong>
                            <p><%= scheme.dependants %></p>
                        </div>

                        <div class="col-md-4">
                            <strong>Total Lives</strong>
                            <p><%= scheme.total_lives %></p>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Financials -->

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Financial Information</strong>
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">
                            <strong>Monthly Premium</strong>
                            <p>KES <%= scheme.monthly_premium %></p>
                        </div>

                        <div class="col-md-4">
                            <strong>Annual Premium</strong>
                            <p>KES <%= scheme.annual_premium %></p>
                        </div>

                        <div class="col-md-4">
                            <strong>Effective Date</strong>
                            <p><%= scheme.effective_date %></p>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Documents -->

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>Uploaded Documents</strong>
                </div>

                <div class="card-body">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Document Name</th>
                                <th>Uploaded By</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                        <% documents.forEach(doc => { %>

                            <tr>
                                <td><%= doc.document_name %></td>
                                <td><%= doc.uploaded_by %></td>
                                <td><%= doc.upload_date %></td>

                                <td>
                                    <%= doc.document_path %>                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>

                        <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Approval Tracking -->

        <div class="col-md-4">

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Approval Progress</strong>
                </div>

                <div class="card-body">

                    <div class="timeline">

                        <% approvals.forEach(step => { %>

                        <div class="timeline-item">

                            <h6>
                                <%= step.stage %>
                            </h6>

                            <small class="text-muted">
                                <%= step.date %>
                            </small>

                            <p class="mt-2 mb-0">
                                <%= step.comment %>
                            </p>

                            <small>
                                By: <%= step.approved_by %>
                            </small>

                        </div>

                        <% }) %>

                    </div>

                </div>

            </div>

            <!-- Reviewer 
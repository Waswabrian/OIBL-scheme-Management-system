<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prospects Management</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --success: #16a34a;
            --warning: #f59e0b;
            --danger: #dc2626;
            --light-bg: #f4f6f9;
            --text-dark: #1e293b;
        }

        body {
            background: var(--light-bg);
            font-family: "Segoe UI", sans-serif;
            color: var(--text-dark);
        }

       .content-wrapper {
            margin-left: 280px;
            padding: 25px;
            min-height: 100vh;
        }

        @media (max-width: 992px) {
            .content-wrapper {
                margin-left: 0;
                padding: 15px;
            }
        }

        .page-header {
            background: #fff;
            border-radius: 18px;
            padding: 25px 30px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .page-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #64748b;
            margin-bottom: 0;
        }

        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 4px 15px rgba(0,0,0,.05);
        }

        .stats-card {
            padding: 20px;
            border-radius: 16px;
            color: white;
        }

        .stats-card h3 {
            margin-top: 10px;
            margin-bottom: 0;
            font-weight: 700;
        }

        .stats-primary {
            background: linear-gradient(135deg,#2563eb,#3b82f6);
        }

        .stats-success {
            background: linear-gradient(135deg,#16a34a,#22c55e);
        }

        .stats-warning {
            background: linear-gradient(135deg,#f59e0b,#fb923c);
        }

        .stats-purple {
            background: linear-gradient(135deg,#7c3aed,#8b5cf6);
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            min-height: 48px;
        }

        .btn {
            border-radius: 10px;
            font-weight: 600;
        }

        .table thead th {
            background: #f8fafc;
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #64748b;
            padding: 15px;
        }

        .table tbody td {
            padding: 15px;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover {
            background: #f8fbff;
        }

        .company-name {
            font-weight: 600;
        }

        .premium {
            color: var(--success);
            font-weight: 700;
        }

        .stage-badge {
            padding: 7px 14px;
            border-radius: 50px;
            font-size: .75rem;
            font-weight: 600;
            display: inline-block;
        }

        .lead-badge {
            background: #dbeafe;
            color: #1e40af;
        }

        .contacted-badge {
            background: #cffafe;
            color: #155e75;
        }

        .proposal-badge {
            background: #fef3c7;
            color: #92400e;
        }

        .negotiation-badge {
            background: #e2e8f0;
            color: #475569;
        }

        .won-badge {
            background: #dcfce7;
            color: #166534;
        }

        .lost-badge {
            background: #fee2e2;
            color: #991b1b;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6b7280;
        }

        .empty-state i {
            font-size: 3rem;
        }

        @media(max-width:768px){
            .page-header{
                flex-direction: column;
                align-items: flex-start !important;
                gap: 15px;
            }

            .btn-group{
                display:flex;
                flex-direction:column;
                gap:5px;
            }
        }
    </style>
</head>

<body>

<div class="container-fluid">

    <%- include('../partials/bdo_sidebar') %>

    <div class="content-wrapper">

        <!-- Header -->
        <div class="page-header d-flex justify-content-between align-items-center">

            <div>
                <h2 class="page-title">
                    <i class="bi bi-people-fill text-primary"></i>
                    Prospects Management
                </h2>

                <p class="page-subtitle">
                    Manage leads and business opportunities
                </p>
            </div>

            <a href="/bdo/prospects/new"
               class="btn btn-primary">
                <i class="bi bi-person-plus-fill"></i>
                New Prospect
            </a>

        </div>

        <!-- Stats -->
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="stats-card stats-primary">
                    <small>Total Prospects</small>
                    <h3><%= prospects.length %></h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stats-card stats-success">
                    <small>Pipeline Value</small>
                   <h3>
    KES <%= Number(pipeline || 0).toLocaleString() %>
</h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stats-card stats-warning">
                    <small>Won Business</small>
                    <h3><%= typeof wonSchemes !== 'undefined' ? wonSchemes : 0 %></h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stats-card stats-purple">
                    <small>Follow Ups Due</small>
                    <h3>
    <%= followups || 0 %>
</h3>
                </div>
            </div>

        </div>

        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body">
                <a href="/bdo-dashboard"
                   class="btn btn-secondary mb-3">
                    <i class="bi bi-arrow-left"></i>
                    Back to Dashboard
                </a>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <input
                                type="text"
                                name="search"
                                class="form-control"
                                value="<%= (typeof req !== 'undefined' && req.query.search) ? req.query.search : '' %>">
                        </div>

                        <div class="col-md-3">
                            <select class="form-select" name="stage">
                                <option value="">All Stages</option>
                                <option value="Lead">Lead</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Proposal Sent">Proposal Sent</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <select class="form-select" name="industry">
                                <option value="">All Industries</option>
                                <option value="Sacco">Sacco</option>
                                <option value="Corporate">Corporate</option>
                                <option value="NGO">NGO</option>
                                <option value="School">School</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button class="btn btn-success w-100">
                                <i class="bi bi-search"></i>
                                Search
                            </button>
                        </div>

                    </div>

                </form>

            </div>
        </div>

        <!-- Prospects Table -->
        <div class="card">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Company</th>
                                <th>Contact Person</th>
                                <th>Phone</th>
                                <!-- <th>Members</th> -->
                                <!-- <th>Premium</th> -->
                                <th>Stage</th>
                                <th>Follow Up</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                        <% if(prospects.length === 0){ %>

                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <i class="bi bi-folder2-open"></i>
                                        <h5 class="mt-3">No Prospects Found</h5>
                                        <p>Create your first prospect to start building your sales pipeline.</p>
                                    </div>
                                </td>
                            </tr>

                        <% } %>

                        <% prospects.forEach(prospect => { %>

                            <tr>

                                <td>
                                    <div class="company-name">
                                        <%= prospect.company_name %>
                                    </div>
                                </td>

                                <td><%= prospect.contact_person %></td>

                                <td><%= prospect.phone %></td>

                                <!-- <td><%= prospect.estimated_members %></td> -->
<!-- 
                                <td class="premium">
                                    KES <%= Number(prospect.estimated_premium || 0).toLocaleString() %>
                                </td> -->
                                

                                <td>

                                    <% if(prospect.stage === 'Lead'){ %>
                                        <span class="stage-badge lead-badge">Lead</span>
                                    <% } %>

                                    <% if(prospect.stage === 'Contacted'){ %>
                                        <span class="stage-badge contacted-badge">Contacted</span>
                                    <% } %>

                                    <% if(prospect.stage === 'Proposal'){ %>
                                        <span class="stage-badge proposal-badge">Proposal Sent</span>
                                    <% } %>

                                    <% if(prospect.stage === 'Negotiation'){ %>
                                        <span class="stage-badge negotiation-badge">Negotiation</span>
                                    <% } %>

                                    <% if(prospect.stage === 'Won'){ %>
                                        <span class="stage-badge won-badge">Won</span>
                                    <% } %>

                                    <% if(prospect.stage === 'Lost'){ %>
                                        <span class="stage-badge lost-badge">Lost</span>
                                    <% } %>

                                </td>

                                <td>
                                    <%= prospect.follow_up_date %>
                                </td>

                                <td>

                                    <div class="btn-group">
                                        <!-- <a href="/bdo/prospects/<%= prospect.prospect_id %>" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a> -->

                                        <a href="/bdo/prospects/edit/<%= prospect.prospect_id %>" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a href="/bdo/schemes/create/<%= prospect.prospect_id %>" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                        </tbody>

                    </table>
                
                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
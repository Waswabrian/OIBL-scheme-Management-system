<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scheme Applications</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet">

    <style>

        body{
            background:#f5f7fb;
            font-family:'Segoe UI',sans-serif;
            color:#1e293b;
        }

        /* Content Area */

        .main-content{
            margin-left:280px;
            padding:30px;
            min-height:100vh;
        }

        @media(max-width:992px){

            .main-content{
                margin-left:0;
                padding:15px;
            }

        }

        /* Header */

        .page-header{
            background:#fff;
            padding:25px 30px;
            border-radius:18px;
            margin-bottom:25px;
            box-shadow:0 4px 15px rgba(0,0,0,.05);
        }

        .page-header h2{
            margin-bottom:5px;
            font-weight:700;
        }

        .page-header p{
            color:#64748b;
            margin:0;
        }

        /* Cards */

        .card{
            border:none;
            border-radius:18px;
            box-shadow:0 4px 15px rgba(0,0,0,.05);
        }

        /* KPI Cards */

        .stats-card{
            color:#fff;
        }
        

        .stats-card .card-body{
            padding:25px;
        }

        .stats-card h6{
            opacity:.85;
            margin-bottom:10px;
        }

        .stats-card h3{
            margin:0;
            font-weight:700;
        }

        .stats-total{
            background:linear-gradient(135deg,#2563eb,#3b82f6);
        }

        .stats-submitted{
            background:linear-gradient(135deg,#0891b2,#22d3ee);
        }

        .stats-approved{
            background:linear-gradient(135deg,#16a34a,#4ade80);
        }

        .stats-pipeline{
            background:linear-gradient(135deg,#7c3aed,#8b5cf6);
        }

        /* Filters */

        .form-control,
        .form-select{
            height:48px;
            border-radius:12px;
        }

        /* Table */

        .table thead th{
            background:#f8fafc;
            color:#64748b;
            font-size:12px;
            text-transform:uppercase;
            border:none;
            padding:16px;
        }

        .table tbody td{
            padding:16px;
            vertical-align:middle;
        }

        .table-hover tbody tr:hover{
            background:#f8fbff;
        }

        .scheme-number{
            color:#2563eb;
            font-weight:700;
        }

        .premium{
            color:#16a34a;
            font-weight:700;
        }

        /* Status */

        .status-badge{
            display:inline-block;
            padding:7px 14px;
            border-radius:50px;
            font-size:12px;
            font-weight:600;
        }

        .badge-Onboarding{
            background:#e2e8f0;
            color:#475569;
        }

        .badge-submitted{
            background:#dbeafe;
            color:#1d4ed8;
        }

        .badge-review{
            background:#fef3c7;
            color:#b45309;
        }

        .badge-approved{
            background:#dcfce7;
            color:#15803d;
        }

        .badge-rejected{
            background:#fee2e2;
            color:#dc2626;
        }

        .badge-activated{
            background:#111827;
            color:#fff;
        }
        .status-badge badge-onboarding{
            background:#e2e8f0;
            color:#475569;
        }
        

    </style>

</head>

<body>

    <%- include('../partials/bdo_sidebar') %>

    <div class="main-content">

        <!-- Header -->

        <div class="page-header d-flex justify-content-between align-items-center">

            <div>
                <h2>Business Applications</h2>
                <p>Manage all business submissions and approval progress</p>
            </div>
            <% if (typeof prospectId !== 'undefined' && prospectId) { %>
                <a href="/bdo/schemes/create/<%= prospectId %>" class="btn btn-success">
                    <i class="bi bi-plus-lg"></i> New Business
                </a>
                <% } else { %>
                <a href="/bdo/prospects" class="btn btn-success">
                    <i class="bi bi-plus-lg"></i> New Business
                </a>
                <% } %>

        </div>

        <!-- Statistics -->

        <div class="row mb-4">

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card stats-card stats-total">
                    <div class="card-body">
                        <h6>Total Businesses</h6>
                        <h3><%= stats.total || 0 %></h3>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card stats-card stats-submitted">
                    <div class="card-body">
                        <h6>Closed Businesses</h6>
                        <h3><%= stats.won || 0 %></h3>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card stats-card stats-approved">
                    <div class="card-body">
                        <h6>Potential</h6>
                        <h3><%= stats.prospects || 0 %></h3>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-3">
                <div class="card stats-card stats-pipeline">
                    <div class="card-body">
                        <h6>Pipeline Value</h6>
                        <h3>

KES <%= Number(stats.pipelineValue || 0).toLocaleString() %>

</h3>
                    </div>
                </div>
            </div>

        </div>

        <!-- Filters -->

        <div class="card mb-4">

            <div class="card-body">
                <a
                    href="/bdo/schemes"
                    class="btn btn-secondary mb-3">
                    <i class="bi bi-arrow-left"></i>
                    Back to Dashboard

                </a>

                <form action="/bdo/schemes" method="GET">

                    <div class="row g-3">

                        <div class="col-md-4">
                            <input
                                type="text"
                                name="search"
                                class="form-control"
                                placeholder="Search scheme..."
                                value="<%= search %>">
                        </div>

                        <div class="col-md-3">
                            <select
                                name="status"
                                class="form-select">

                                <option value="">All Statuses</option>
                                <option value="Onboarding">Onboarding</option>
                                <option value="Pending_Renewal">Pending_Renewal</option>
                                <option value="Renewed">Renewed</option>
                                <option value="Lost">Lost</option>
                                <option value="Active">Active</option>

                            </select>
                        </div>

                        <div class="col-md-3">
                            <select
                                name="product"
                                class="form-select">

                                <option value="">All Products</option>
                                <option value="Medical Insurance">Medical Insurance</option>
                                <option value="Group Life">Group Life</option>
                                <option value="Last Expense">Last Expense</option>
                                <option value="WIBA">WIBA</option>

                            </select>
                        </div>

                        <div class="col-md-2">
                            <button
                                type="submit"
                                class="btn btn-success w-100">
                                Search
                            </button>
                        </div>

                    </div>

                </form>

            </div>

        </div>

        <!-- Schemes Table -->

        <div class="card">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                        <tr>
                            <th>Scheme No</th>
                            <th>Scheme Name</th>
                            <!-- <th>Client</th> -->
                            <th>Product</th>
                            <th>Premium</th>
                            <th>Status</th>
                            <th>Allocations</th>
                            <th>Updated On </th>
                            <!-- <th>Action</th> -->
                        </tr>
                        </thead>

                        <tbody>

                        <% if(schemes && schemes.length > 0){ %>

                            <% schemes.forEach(scheme => { %>

                                <tr>

                                    <td class="scheme-number">
                                        <%= scheme.scheme_id %>
                                    </td>

                                    <td>
                                        <%= scheme.scheme_name %>
                                    </td>

                                    <!-- <td>
                                        <%= scheme.company_name %>
                                    </td> -->

                                    <td>
                                        <%= scheme.policy_type || '' %>
                                    </td>

                                    <td >
                                        KES <%= Number(scheme.premium || 0).toLocaleString() %>
                                    </td>

                                    <td>
                                        <% if (scheme.status === 'Onboarding') { %>
                                            <span class="status-badge badge-onboarding">Onboarding</span>
                                        <% } else if (scheme.status === 'Pending_Renewal') { %>
                                            <span class="status-badge badge-submitted">Pending Renewal</span>
                                        <% } else if (scheme.status === 'Renewed') { %>
                                            <span class="status-badge badge-approved">Renewed</span>
                                        <% } else if (scheme.status === 'Won') { %>
                                            <span class="status-badge badge-approved">Won</span>
                                        <% } else if (scheme.status === 'Lost') { %>
                                            <span class="status-badge badge-rejected">Lost</span>
                                        <% } else { %>
                                            <span class="status-badge badge-Onboarding"><%= scheme.status || 'Onboarding' %></span>
                                        <% } %>
                                    </td>

                                    <td>
                                        <%= scheme.assigned_to || 'Not Assigned' %>
                                    </td>

                                    <td>
                                        <%= scheme.inception_date ? new Date(scheme.inception_date).toLocaleDateString() : 'N/A' %>
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">
                                            <% if (scheme.status === 'Onboarding' || scheme.status === 'Rejected') { %>
                                                <a href="/bdo/schemes/update/<%= scheme.scheme_id %>" class="btn btn-sm btn-outline-warning">
                                                    Edit
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    No scheme applications found.
                                </td>
                            </tr>

                        <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</body>
</html>
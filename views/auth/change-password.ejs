<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password | OIBL Schemes</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="auth-body">
    <div class="auth-shell">
      <div class="auth-card">
        <div class="auth-brand">
          <img src="/images/OCTAGON-LOGO.png" alt="OCTAGON logo" />
        </div>

        <h1><%= forced ? 'Update your password' : 'Change your password' %></h1>
        <p class="auth-subtitle">
          <%= forced ? 'Your account requires a password update before you can continue.' : 'Use a strong password you can remember.' %>
        </p>

        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <% if (success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <form method="POST" action="/change-password">
          <% if (!forced) { %>
            <label class="form-group">
              <span>Current password</span>
              <input type="password" name="current_password" placeholder="Enter current password" required />
            </label>
          <% } %>

          <label class="form-group">
            <span>New password</span>
            <input type="password" name="new_password" placeholder="Enter new password" required />
          </label>

          <label class="form-group">
            <span>Confirm password</span>
            <input type="password" name="confirm_password" placeholder="Re-enter new password" required />
          </label>

          <button type="submit" class="btn btn-primary auth-btn">Update password</button>
        </form>
      </div>
    </div>
  </body>
</html>

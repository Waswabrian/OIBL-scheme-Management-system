<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OIBL CENTER</title>
    <meta
      name="description"
      content="OIBL Schemes Management System.."
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container nav">
        <div class="brand" aria-label="OCTAGON logo">
          <img src="/images/OCTAGON-LOGO.png" alt="OCTAGON Africa logo" />
        </div>

        <nav class="nav-links" aria-label="Main navigation">
          
      
        </nav>

        <div class="nav-actions">
          <a class="btn btn-secondary" href="/signup">Sign up</a>
          <a class="btn btn-primary" href="/login">Login</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <span class="kicker">OIBL CENTER</span>
            <h1>
              OCTAGON INSURANCE
              <span class="highlight">BROKERS</span>
              LIMITED.
            </h1>
            <p>
              OIBL  Management System
            </p>

            <div class="hero-actions">
              <a class="btn btn-primary" href="/login">Get started</a>
              <!-- <a class="btn btn-secondary" href="#features">See features</a> -->
            </div>
          </div>

          <div class="hero-card">
            <div class="dashboard-window">
              <div class="window-header">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>

              <div class="window-body">
                <div class="summary-card">
                  <h3>Scheme Overview</h3>
                  <div class="summary-stat">
                    <strong>1,284</strong>
                    <span class="badge">+18.4%</span>
                  </div>
                </div>

                <div class="list-row">
                  <div>
                    <strong>Staff Allocation</strong><br />
                    <small>Updated today</small>
                  </div>
                  <span class="badge">Live</span>
                </div>

                <div class="list-row">
                  <div>
                    <strong>Pending Reviews</strong><br />
                    <small>12 awaiting approval</small>
                  </div>
                  <span>12</span>
                </div>

                <div class="list-row">
                  <div>
                    <strong>Approved Schemes</strong><br />
                    <small>Last 30 days</small>
                  </div>
                  <span>92%</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

     
    </main>

    <footer class="footer">
      <div class="container footer-row">
        <span>© 2026 guyva codes ltd</span>
        <span>Designed by <a href="mailto:brian.wekesa@octagonafrica.com" target="_blank">guyva.codes</a></span>
      </div>
    </footer>
  </body>
</html>

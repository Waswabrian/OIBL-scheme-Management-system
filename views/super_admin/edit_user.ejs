<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary: #123d6b;
            --sidebar: #0f172a;
            --text: #1f2937;
            --muted: #6b7280;
        }

        body {
            margin: 0;
            background: #f4f7fb;
            color: var(--text);
            font-family: "Segoe UI", sans-serif;
        }

        .sidebar {
            background: var(--sidebar);
            min-height: 100vh;
            width: 260px;
            position: sticky;
            top: 0;
        }

        .sidebar .brand {
            display: flex;
            justify-content: center;
            padding: 1rem 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar .brand img {
            width: 150px;
        }

        .sidebar nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.85rem 1.25rem;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-weight: 500;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: rgba(255,255,255,0.08);
            color: #fff;
        }

        .main-panel {
            flex: 1;
            min-width: 0;
        }

        .topbar {
            background: linear-gradient(90deg, var(--primary) 0%, #1b4d82 100%);
            color: white;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.12);
        }

        .user-pill {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.18);
            border-radius: 999px;
            padding: 0.55rem 0.9rem;
            font-weight: 600;
        }

        .content-wrap {
            padding: 2rem;
        }

        .page-header {
            background: white;
            border-radius: 16px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.06);
        }

        .page-header h2 {
            margin: 0;
            color: var(--primary);
            font-weight: 700;
        }

        .required {
            color: #dc2626;
        }

        .panel-card {
            background: white;
            border: 1px solid rgba(17,24,39,0.06);
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.06);
        }

        .panel-card .card-body {
            padding: 1.5rem;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                min-height: auto;
            }

            .content-wrap {
                padding: 1rem;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.75rem;
            }
        }
    </style>
</head>
<body>
    <div class="d-flex flex-column flex-md-row">
        <aside class="sidebar">
            <div class="brand">
                <img src="/images/OCTAGON-LOGO.png" alt="OIBL Logo">
            </div>

            <nav>
                <a href="/super-admin-dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a href="/super-admin/users" class="active"><i class="bi bi-people-fill"></i> Users</a>
                <a href="/super-admin/roles"><i class="bi bi-shield-lock-fill"></i> Roles</a>
                <a href="/super-admin/audit"><i class="bi bi-journal-text"></i> Audit Logs</a>
                <a href="/super-admin/settings"><i class="bi bi-gear-fill"></i> Settings</a>
                <a href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
            </nav>
        </aside>

        <main class="main-panel">
            <div class="topbar">
                <h2>Edit User</h2>
                <span class="user-pill">Welcome, <%= user.full_name %></span>
            </div>

            <div class="content-wrap">
                <div class="page-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h2>Edit User</h2>
                            <p class="text-muted mb-0">Update user details, role and account status.</p>
                        </div>
                        <a href="/super-admin/users" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Users
                        </a>
                    </div>
                </div>

                <div class="panel-card">
                    <div class="card-body">
                        <form action="/super-admin/users/update/<%= selectedUser.staff_id %>" method="POST">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Full Name <span class="required">*</span></label>
                                    <input type="text" name="full_name" class="form-control" value="<%= selectedUser.full_name %>" required>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email <span class="required">*</span></label>
                                    <input type="email" name="email" class="form-control" value="<%= selectedUser.email %>" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Role</label>
                                    <select name="role" class="form-select">
                                        <option value="Super Admin" <%= selectedUser.role === 'Super Admin' ? 'selected' : '' %>>Super Admin</option>
                                        <option value="Admin" <%= selectedUser.role === 'Admin' ? 'selected' : '' %>>Admin</option>
                                        <option value="Business Development Officer" <%= selectedUser.role === 'Business Development Officer' ? 'selected' : '' %>>Business Development Officer</option>
                                        <option value="Staff" <%= selectedUser.role === 'Staff' ? 'selected' : '' %>>Staff</option>
                                    </select>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Status</label>
                                    <select name="status" class="form-select">
                                        <option value="Active" <%= selectedUser.status === 'Active' ? 'selected' : '' %>>Active</option>
                                        <option value="Inactive" <%= selectedUser.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">New Password</label>
                                <input type="password" name="password" class="form-control">
                                <small class="text-muted">Leave blank to keep the current password.</small>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" name="force_password_change" value="1" id="forcePasswordChange" <%= selectedUser.password_reset_required ? 'checked' : '' %>>
                                <label class="form-check-label" for="forcePasswordChange">
                                    Require this user to change password on next login
                                </label>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-end gap-2">
                                <a href="/super-admin/users" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
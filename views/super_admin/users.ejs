<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body{
            background:#f4f6f9;
        }

        .sidebar{
            min-height:100vh;
            background:#1e293b;
        }

        .sidebar a{
            color:#fff;
            text-decoration:none;
            display:block;
            padding:12px 20px;
        }

        .sidebar a:hover{
            background:#334155;
        }

        .card{
            border:none;
            border-radius:15px;
        }

        .stat-card{
            color:#fff;
        }

        .users-card{
            background:#0d6efd;
        }

        .admin-card{
            background:#198754;
        }

        .bdo-card{
            background:#fd7e14;
        }

        .inactive-card{
            background:#dc3545;
        }

        .page-title{
            font-weight:700;
        }

        .table th{
            background:#f8fafc;
        }

    </style>
</head>
<body>

<div class="container-fluid">

    <div class="row">

        <!-- Sidebar -->

        <div class="col-md-2 sidebar p-0">

            <h4 class="text-center text-white py-4">
                OIBL Admin
            </h4>
            <a href="/super-admin-dashboard"
               class="d-flex align-items-center gap-2">

                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a href="/super-admin/users"
               class="d-flex align-items-center gap-2">

                <i class="bi bi-people-fill"></i>
                Users
            </a>

            <a href="/super-admin/roles"
               class="d-flex align-items-center gap-2">

                <i class="bi bi-shield-lock-fill"></i>
                Roles
            </a>

            <a href="/super-admin/settings"
               class="d-flex align-items-center gap-2">

                <i class="bi bi-gear-fill"></i>
                Settings
            </a>

            <a href="/super-admin/audit"
               class="d-flex align-items-center gap-2">


                <i class="bi bi-file-earmark-text"></i>
                Audit Logs
            </a>

            <a href="/logout"
               class="d-flex align-items-center gap-2">

                <i class="bi bi-box-arrow-right"></i>
                Logout
            </a>

        </div>

        <!-- Main Content -->

        <div class="col-md-10 p-4">

            <!-- Header -->

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h2 class="page-title">
                        User Management
                    </h2>

                    <p class="text-muted">
                        Manage system users, roles and access rights.
                    </p>
                </div>

                <div>
                    <span class="badge bg-danger fs-6">
                        Super Admin
                    </span>
                </div>

            </div>

            <!-- Stats -->

            <div class="row g-3 mb-4">

                <div class="col-md-3">
                    <div class="card stat-card users-card shadow">
                        <div class="card-body">
                            <h6>Total Users</h6>
                            <h2><%= users.length %></h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card stat-card admin-card shadow">
                        <div class="card-body">
                            <h6>Admins</h6>

                            <h2>
                                <%= users.filter(u =>
                                    u.role === 'Admin' ||
                                    u.role === 'Super Admin'
                                ).length %>
                            </h2>

                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card stat-card bdo-card shadow">
                        <div class="card-body">
                            <h6>BDOs</h6>

                            <h2>
                                <%= users.filter(u =>
                                    u.role === 'Business Development Officer'
                                ).length %>
                            </h2>

                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card stat-card inactive-card shadow">
                        <div class="card-body">
                            <h6>Inactive</h6>

                            <h2>
                                <%= users.filter(u =>
                                    u.status === 'Inactive'
                                ).length %>
                            </h2>
                        </div>
                    </div>
                </div>

            </div>

            <!-- User Table -->

            <div class="card shadow">

                <div class="card-header bg-white">

                    <div class="row">

                        <div class="col-md-6">
                            <h5 class="mb-0">
                                Staff Accounts
                            </h5>
                        </div>

                        <div class="col-md-6">
                            <input
                                type="text"
                                id="searchInput"
                                class="form-control"
                                placeholder="Search user...">
                        </div>

                    </div>

                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle"
                               id="usersTable">

                            <thead>

                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th style="width: 180px;">Actions</th>
                                </tr>

                            </thead>

                            <tbody>

                            <% users.forEach(user => { %>

                                <tr>

                                    <td>
                                        <%= user.staff_id %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= user.full_name %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= user.email %>
                                    </td>

                                    <td>

                                        <% if(user.role === 'Super Admin'){ %>

                                            <span class="badge bg-danger">
                                                Super Admin
                                            </span>

                                        <% } else if(user.role === 'Admin'){ %>

                                            <span class="badge bg-success">
                                                Admin
                                            </span>

                                        <% } else if(user.role === 'Business Development Officer'){ %>

                                            <span class="badge bg-warning text-dark">
                                                BDO
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-secondary">
                                                Staff
                                            </span>

                                        <% } %>

                                    </td>

                                    <td>

                                        <% if(user.status === 'Active'){ %>

                                            <span class="badge bg-success">
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>

                                        <% } %>

                                    </td>

                                    <td>

                                        <a href="/super-admin/users/edit/<%= user.staff_id %>" class="btn btn-primary btn-sm">

                                            <i class="bi bi-pencil-square"></i>
                                            Edit

                                        </a>

                                        <a href="/super-admin/users/deactivate/<%= user.staff_id %>" class="btn btn-danger btn-sm"
                                           onclick="return confirm('Deactivate this user?')">

                                            <i class="bi bi-person-x-fill"></i>
                                            Disable

                                        </a>

                                    </td>

                                </tr>

                            <% }) %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script>

document.getElementById('searchInput')
.addEventListener('keyup', function() {

    let filter =
        this.value.toLowerCase();

    let rows =
        document.querySelectorAll('#usersTable tbody tr');

    rows.forEach(row => {

        let text =
            row.textContent.toLowerCase();

        row.style.display =
            text.includes(filter)
            ? ''
            : 'none';

    });

});

</script>

</body>
</html>






































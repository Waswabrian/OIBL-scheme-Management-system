<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Management</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    :root {
      --primary: #123d6b;
      --primary-soft: #ebf3ff;
      --sidebar: #0f172a;
      --text: #1f2937;
      --muted: #6b7280;
      --card-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    }

    body {
      margin: 0;
      background: #f4f7fb;
      color: var(--text);
      font-family: "Segoe UI", sans-serif;
    }

    .sidebar {
      background: var(--sidebar);
      min-height: 100vh;
      width: 260px;
      position: sticky;
      top: 0;
      padding: 0;
    }

    .sidebar .brand {
      display: flex;
      justify-content: center;
      padding: 1rem 1.25rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar .brand img {
      width: 150px;
    }

    .sidebar nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0.9rem 1.25rem;
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      font-weight: 500;
    }

    .sidebar nav a:hover,
    .sidebar nav a.active {
      background: rgba(255,255,255,0.08);
      color: #fff;
    }

    .main-panel { flex: 1; }

    .topbar {
      background: linear-gradient(90deg, var(--primary) 0%, #1b4d82 100%);
      color: white;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--card-shadow);
    }

    .topbar h2 {
      margin: 0;
      font-size: 1.6rem;
      font-weight: 700;
    }

    .user-pill {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      color: #fff;
      border-radius: 999px;
      padding: 0.5rem 0.9rem;
      font-weight: 600;
    }

    .content-wrap { padding: 2rem; }

    .metric-card {
      border: none;
      border-radius: 18px;
      box-shadow: var(--card-shadow);
      color: #fff;
      overflow: hidden;
    }

    .metric-card .card-body {
      padding: 1.2rem 1.1rem;
    }

    .metric-card h6 {
      opacity: 0.9;
      margin-bottom: 0.75rem;
    }

    .metric-card h2 {
      margin: 0;
      font-size: 2rem;
      font-weight: 700;
    }

    .users-card { background: linear-gradient(135deg, #0d6efd, #3a8dff); }
    .admin-card { background: linear-gradient(135deg, #198754, #39b56f); }
    .bdo-card { background: linear-gradient(135deg, #fd7e14, #ff9f43); }
    .inactive-card { background: linear-gradient(135deg, #dc3545, #ff5d73); }

    .panel-card {
      background: white;
      border-radius: 18px;
      border: 1px solid rgba(17,24,39,0.06);
      box-shadow: var(--card-shadow);
    }

    .panel-card .card-header {
      background: var(--primary-soft);
      color: var(--primary);
      border-bottom: 1px solid rgba(18,61,107,0.08);
      padding: 1rem 1.25rem;
      font-weight: 700;
    }

    .panel-card .card-body { padding: 1.2rem; }

    .table th {
      background: #f8fafc;
      color: var(--primary);
      font-weight: 700;
    }

    .btn-danger { background: #dc3545; border-color: #dc3545; }

    @media (max-width: 768px) {
      .sidebar { width: 100%; min-height: auto; position: relative; }
      .content-wrap { padding: 1rem; }
      .topbar { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    }
  </style>
</head>
<body>
  <div class="d-flex flex-column flex-md-row">
    <aside class="sidebar">
      <div class="brand">
        <img src="/images/OCTAGON-LOGO.png" alt="OIBL Logo" />
      </div>
      <nav>
        <a href="/super-admin-dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="/super-admin/users" class="active"><i class="bi bi-people-fill"></i> Users</a>
        <a href="/super-admin/roles"><i class="bi bi-shield-lock-fill"></i> Roles</a>
        <a href="/super-admin/audit"><i class="bi bi-journal-text"></i> Audit Logs</a>
        <a href="/super-admin/settings"><i class="bi bi-gear-fill"></i> Settings</a>
        <a href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-panel">
      <div class="topbar">
        <h2>User Management</h2>
        <span class="user-pill">Welcome, <%= user.full_name %></span>
      </div>

      <div class="content-wrap">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <div class="row g-3 mb-4">
          <div class="col-md-3">
            <div class="metric-card users-card shadow">
              <div class="card-body">
                <h6>Total Users</h6>
                <h2><%= users.length %></h2>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="metric-card admin-card shadow">
              <div class="card-body">
                <h6>Admins</h6>
                <h2><%= users.filter(u => u.role === 'Admin' || u.role === 'Super Admin').length %></h2>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="metric-card bdo-card shadow">
              <div class="card-body">
                <h6>BDOs</h6>
                <h2><%= users.filter(u => u.role === 'Business Development Officer').length %></h2>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="metric-card inactive-card shadow">
              <div class="card-body">
                <h6>Inactive</h6>
                <h2><%= users.filter(u => u.status === 'Inactive').length %></h2>
              </div>
            </div>
          </div>
        </div>

        <div class="panel-card shadow-sm">
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <span>Staff Accounts</span>
            <input type="text" id="searchInput" class="form-control" style="max-width: 260px;" placeholder="Search user..." />
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover align-middle" id="usersTable">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Password</th>
                    <th style="width: 200px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(user => { %>
                    <tr>
                      <td><%= user.staff_id %></td>
                      <td><strong><%= user.full_name %></strong></td>
                      <td><%= user.email %></td>
                      <td>
                        <% if (user.role === 'Super Admin') { %>
                          <span class="badge bg-danger">Super Admin</span>
                        <% } else if (user.role === 'Admin') { %>
                          <span class="badge bg-success">Admin</span>
                        <% } else if (user.role === 'Business Development Officer') { %>
                          <span class="badge bg-warning text-dark">BDO</span>
                        <% } else { %>
                          <span class="badge bg-secondary">Staff</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (user.status === 'Active') { %>
                          <span class="badge bg-success">Active</span>
                        <% } else { %>
                          <span class="badge bg-danger">Inactive</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (user.password_reset_required) { %>
                          <span class="badge bg-warning text-dark">Reset Required</span>
                        <% } else { %>
                          <span class="badge bg-success">Updated</span>
                        <% } %>
                      </td>
                      <td>
                        <a href="/super-admin/users/edit/<%= user.staff_id %>" class="btn btn-primary btn-sm me-1">
                          <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <form action="/super-admin/users/reset-password/<%= user.staff_id %>" method="POST" class="d-inline" onsubmit="return confirm('Reset this user password?')">
                          <button type="submit" class="btn btn-warning btn-sm me-1">
                            <i class="bi bi-key-fill"></i> Reset
                          </button>
                        </form>
                        <a href="/super-admin/users/deactivate/<%= user.staff_id %>" class="btn btn-danger btn-sm" onclick="return confirm('Deactivate this user?')">
                          <i class="bi bi-person-x-fill"></i> Disable
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    document.getElementById('searchInput')?.addEventListener('keyup', function () {
      const filter = this.value.toLowerCase();
      const rows = document.querySelectorAll('#usersTable tbody tr');

      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? '' : 'none';
      });
    });
  </script>
</body>
</html>

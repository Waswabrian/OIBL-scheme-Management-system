<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>System Settings</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    :root {
      --primary: #123d6b;
      --sidebar: #0f172a;
      --card-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    }

    body {
      margin: 0;
      background: #f4f7fb;
      color: #1f2937;
      font-family: "Segoe UI", sans-serif;
    }

    .sidebar {
      background: var(--sidebar);
      min-height: 100vh;
      width: 260px;
      position: sticky;
      top: 0;
    }

    .sidebar .brand {
      display: flex;
      justify-content: center;
      padding: 1rem 1.25rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar .brand img { width: 150px; }

    .sidebar nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0.9rem 1.25rem;
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      font-weight: 500;
    }

    .sidebar nav a:hover,
    .sidebar nav a.active {
      background: rgba(255,255,255,0.08);
      color: #fff;
    }

    .main-panel { flex: 1; }

    .topbar {
      background: linear-gradient(90deg, var(--primary) 0%, #1b4d82 100%);
      color: white;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--card-shadow);
    }

    .topbar h2 {
      margin: 0;
      font-size: 1.6rem;
      font-weight: 700;
    }

    .user-pill {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 999px;
      padding: 0.5rem 0.9rem;
      font-weight: 600;
    }

    .content-wrap { padding: 2rem; }

    .panel-card {
      background: white;
      border-radius: 18px;
      border: 1px solid rgba(17,24,39,0.06);
      box-shadow: var(--card-shadow);
    }

    .panel-card .card-header {
      background: #edf4ff;
      color: var(--primary);
      border-bottom: 1px solid rgba(18,61,107,0.08);
      padding: 1rem 1.25rem;
      font-weight: 700;
    }

    .panel-card .card-body { padding: 1.4rem; }

    .form-label {
      font-weight: 600;
      color: var(--primary);
    }

    @media (max-width: 768px) {
      .sidebar { width: 100%; min-height: auto; position: relative; }
      .content-wrap { padding: 1rem; }
      .topbar { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    }
  </style>
</head>
<body>
  <div class="d-flex flex-column flex-md-row">
    <aside class="sidebar">
      <div class="brand">
        <img src="/images/OCTAGON-LOGO.png" alt="OIBL Logo" />
      </div>
      <nav>
        <a href="/super-admin-dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="/super-admin/users"><i class="bi bi-people-fill"></i> Users</a>
        <a href="/super-admin/roles"><i class="bi bi-shield-lock-fill"></i> Roles</a>
        <a href="/super-admin/audit"><i class="bi bi-journal-text"></i> Audit Logs</a>
        <a href="/super-admin/settings" class="active"><i class="bi bi-gear-fill"></i> Settings</a>
        <a href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-panel">
      <div class="topbar">
        <h2>System Settings</h2>
        <span class="user-pill">Welcome, <%= user.full_name %></span>
      </div>

      <div class="content-wrap">
        <div class="panel-card shadow-sm">
          <div class="card-header">Application Settings</div>
          <div class="card-body">
            <form action="/super-admin/settings/update" method="POST">
              <div class="mb-3">
                <label class="form-label">Company Name</label>
                <input type="text" name="company_name" value="<%= settings.company_name %>" class="form-control" />
              </div>

              <div class="mb-3">
                <label class="form-label">System Email</label>
                <input type="email" name="system_email" value="<%= settings.system_email %>" class="form-control" />
              </div>

              <div class="mb-3">
                <label class="form-label">Default Password Length</label>
                <input type="number" name="password_length" value="<%= settings.password_length %>" class="form-control" />
              </div>

              <button class="btn btn-success">
                <i class="bi bi-check-circle"></i> Save Settings
              </button>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Super Admin Dashboard</title>

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background: #f5f7fa;
        }

        .sidebar {
            min-height: 100vh;
            background: #1e293b;
        }

        .sidebar a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 12px 20px;
            transition: .3s;
        }

        .sidebar a:hover {
            background: #334155;
        }

        .card {
            border: none;
            border-radius: 15px;
        }

        .metric {
            font-size: 32px;
            font-weight: 700;
        }

        .card-users {
            background: #0d6efd;
            color: white;
        }

        .card-schemes {
            background: #198754;
            color: white;
        }

        .card-allocations {
            background: #fd7e14;
            color: white;
        }

        .card-bdo {
            background: #dc3545;
            color: white;
        }

        .card-icon {
            font-size: 2rem;
            opacity: .8;
        }

        .activity-item:last-child {
            border-bottom: none !important;
        }
    </style>
</head>

<body>

<div class="container-fluid">

    <div class="row">

        <!-- Sidebar -->
         
        <div class="col-md-2 sidebar p-0">
            <img src="/images/OCTAGON-LOGO.png" alt="Logo" class="img-fluid my-4 mx-auto d-block" style="max-width: 150px;">

<!-- 
            <h4 class="text-white text-center py-4">
                <a href="/super-admin-dashboard" class="text-white">
                    Super Admin
                </a>
            </h4> -->

            <a href="/super-admin-dashboard">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a href="/super-admin/users">
                <i class="bi bi-people-fill"></i>
                Users
            </a>

            <a href="/views/super_admin/schemes.ejs">
                <i class="bi bi-folder-fill"></i>
                Schemes
            </a>

            <a href="/views/super_admin/allocations.ejs">
                <i class="bi bi-diagram-3-fill"></i>
                Allocations
            </a>

            <a href="/views/super_admin/audit.ejs">
                <i class="bi bi-file-earmark-text"></i>
                Audit Logs
            </a>

            <a href="/views/super_admin/settings.ejs">
                <i class="bi bi-gear-fill"></i>
                Settings
            </a>

            <a href="/logout">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </a>

        </div>

        <!-- Main Content -->

        <div class="col-md-10 p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h2>Super Admin Dashboard</h2>

                    <p class="text-muted">
                        Welcome back,
                        <strong><%= user.full_name %></strong>
                    </p>
                </div>

                <div>
                    <span class="badge bg-danger fs-6">
                        Super Admin
                    </span>
                </div>

            </div>

            <!-- Stat Cards -->

            <div class="row g-3 mb-4">

                <div class="col-md-3">
                    <div class="card card-users shadow">
                        <div class="card-body">

                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6>Total Users</h6>
                                    <div class="metric">
                                        <%= stats.users %>
                                    </div>
                                </div>

                                <i class="bi bi-people-fill card-icon"></i>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card card-schemes shadow">
                        <div class="card-body">

                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6>Total Schemes</h6>
                                    <div class="metric">
                                        <%= stats.schemes %>
                                    </div>
                                </div>

                                <i class="bi bi-folder-fill card-icon"></i>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card card-allocations shadow">
                        <div class="card-body">

                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6>Allocations</h6>
                                    <div class="metric">
                                        <%= stats.allocations %>
                                    </div>
                                </div>

                                <i class="bi bi-diagram-3-fill card-icon"></i>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card card-bdo shadow">
                        <div class="card-body">

                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6>BDO Users</h6>
                                    <div class="metric">
                                        <%= stats.bdos %>
                                    </div>
                                </div>

                                <i class="bi bi-person-badge-fill card-icon"></i>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

            <!-- Second Row -->

            <div class="row g-4">

                <!-- Quick Actions -->

                <div class="col-lg-4">

                    <div class="card shadow-sm">

                        <div class="card-header">
                            Quick Actions
                        </div>

                        <div class="card-body d-grid gap-2">

                            <a href="/super-admin/users/edit/:id" class="btn btn-outline-primary">
                                User Management
                            </a>

                            <a href="/views/super_admin/roles.ejs" class="btn btn-outline-primary">
                                Roles & Permissions
                            </a>

                            <a href="/views/super_admin/settings.ejs" class="btn btn-outline-primary">
                                System Settings
                            </a>

                            <a href="/views/super_admin/audit.ejs" class="btn btn-outline-primary">
                                Audit Logs
                            </a>

                        </div>

                    </div>

                    <div class="card shadow-sm mt-4">

                        <div class="card-header">
                            System Health
                        </div>

                        <div class="card-body">

                            <p class="text-success">
                                ✅ Database Connected
                            </p>

                            <p class="text-success">
                                ✅ Server Running
                            </p>

                            <p class="text-success">
                                ✅ Authentication Active
                            </p>

                        </div>

                    </div>

                </div>

                <!-- Activity -->

                <div class="col-lg-8">

                    <div class="card shadow-sm">

                        <div class="card-header">
                            Recent Activities
                        </div>

                        <div class="card-body">

                            <% if (activities.length === 0) { %>

                                <div class="text-center text-muted">
                                    No recent activities found.
                                </div>

                            <% } else { %>

                                <% activities.forEach(activity => { %>

                                    <div class="activity-item border-bottom pb-3 mb-3">

                                        <strong>
                                            <%= activity.title %>
                                        </strong>

                                        <br>

                                        <small class="text-muted">
                                            <%= activity.time %>
                                        </small>

                                        <p class="mb-0 mt-2">
                                            <%= activity.detail %>
                                        </p>

                                    </div>

                                <% }) %>

                            <% } %>

                        </div>

                    </div>

                    <!-- Analytics Placeholder -->

                    <div class="card shadow-sm mt-4">

                        <div class="card-header">
                            Analytics Overview
                        </div>

                        <div class="card-body text-center">

                            <i class="bi bi-bar-chart-line fs-1 text-primary"></i>

                            <p class="mt-3 text-muted">
                                Future Chart.js analytics will appear here.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.jsscript>

</body>

</html>
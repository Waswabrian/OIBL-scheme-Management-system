<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Super Admin Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    :root {
      --primary: #123d6b;
      --primary-soft: #ebf3ff;
      --sidebar: #0f172a;
      --text: #1f2937;
      --muted: #6b7280;
      --success: #16a34a;
      --warning: #f59e0b;
      --card-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
    }

    body {
      margin: 0;
      background: #f4f7fb;
      color: var(--text);
      font-family: "Segoe UI", sans-serif;
    }

    .sidebar {
      background: var(--sidebar);
      min-height: 100vh;
      width: 260px;
      position: sticky;
      top: 0;
      padding: 0;
    }

    .sidebar .brand {
      display: flex;
      justify-content: center;
      padding: 1rem 1.25rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar .brand img {
      width: 150px;
    }

    .sidebar nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0.9rem 1.25rem;
      color: rgba(255, 255, 255, 0.85);
      text-decoration: none;
      font-weight: 500;
      transition: 0.2s ease;
    }

    .sidebar nav a:hover,
    .sidebar nav a.active {
      background: rgba(255,255,255,0.08);
      color: #fff;
    }

    .main-panel { flex: 1; }

    .topbar {
      background: linear-gradient(90deg, var(--primary) 0%, #1b4d82 100%);
      color: white;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--card-shadow);
    }

    .topbar h2 {
      margin: 0;
      font-size: 1.6rem;
      font-weight: 700;
    }

    .user-pill {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      color: #fff;
      border-radius: 999px;
      padding: 0.5rem 0.9rem;
      font-weight: 600;
    }

    .content-wrap { padding: 2rem; }

    .metric-card {
      background: white;
      border: 1px solid rgba(17,24,39,0.06);
      border-radius: 18px;
      box-shadow: var(--card-shadow);
      overflow: hidden;
    }

    .metric-card .card-body {
      padding: 1.25rem 1.2rem;
    }

    .metric-card .metric-label {
      color: var(--muted);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04rem;
    }

    .metric-card .metric-value {
      font-size: 2rem;
      font-weight: 700;
      margin-top: 0.5rem;
      color: var(--primary);
    }

    .metric-card .icon-box {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      color: #fff;
      background: linear-gradient(135deg, #0d6efd, #4f8ef7);
    }

    .card-custom {
      background: white;
      border: 1px solid rgba(17,24,39,0.06);
      border-radius: 16px;
      box-shadow: var(--card-shadow);
    }

    .card-custom .card-header {
      background: var(--primary-soft);
      color: var(--primary);
      border-bottom: 1px solid rgba(18, 61, 107, 0.08);
      font-weight: 700;
      padding: 1rem 1.25rem;
    }

    .card-custom .card-body { padding: 1.2rem; }

    .activity-item:last-child { border-bottom: none !important; }

    .btn-primary {
      background: var(--primary);
      border-color: var(--primary);
    }

    .btn-primary:hover {
      background: #0f3565;
      border-color: #0f3565;
    }

    @media (max-width: 768px) {
      .sidebar { width: 100%; min-height: auto; position: relative; }
      .content-wrap { padding: 1rem; }
      .topbar { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    }
  </style>
</head>
<body>
  <div class="d-flex flex-column flex-md-row">
    <aside class="sidebar">
      <div class="brand">
        <img src="/images/OCTAGON-LOGO.png" alt="OIBL Logo" />
      </div>
      <nav>
        <a href="/super-admin-dashboard" class="active"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="/super-admin/users"><i class="bi bi-people-fill"></i> Users</a>
        <a href="/super-admin/roles"><i class="bi bi-shield-lock-fill"></i> Roles</a>
        <a href="/super-admin/audit"><i class="bi bi-journal-text"></i> Audit Logs</a>
        <a href="/super-admin/settings"><i class="bi bi-gear-fill"></i> Settings</a>
        <a href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-panel">
      <div class="topbar">
        <h2>Super Admin Dashboard</h2>
        <span class="user-pill">Welcome, <%= user.full_name %></span>
      </div>

      <div class="content-wrap">
        <div class="row g-3 mb-4">
          <div class="col-md-3">
            <div class="metric-card">
              <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                  <div class="metric-label">Total Users</div>
                  <div class="metric-value"><%= stats.users %></div>
                </div>
                <div class="icon-box bg-primary"><i class="bi bi-people-fill"></i></div>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="metric-card">
              <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                  <div class="metric-label">Total Schemes</div>
                  <div class="metric-value"><%= stats.schemes %></div>
                </div>
                <div class="icon-box bg-success"><i class="bi bi-folder-fill"></i></div>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="metric-card">
              <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                  <div class="metric-label">Allocations</div>
                  <div class="metric-value"><%= stats.allocations %></div>
                </div>
                <div class="icon-box bg-warning"><i class="bi bi-diagram-3-fill"></i></div>
              </div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="metric-card">
              <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                  <div class="metric-label">BDO Users</div>
                  <div class="metric-value"><%= stats.bdos %></div>
                </div>
                <div class="icon-box bg-danger"><i class="bi bi-person-badge-fill"></i></div>
              </div>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <div class="col-lg-4">
            <div class="card-custom">
              <div class="card-header">Quick Actions</div>
              <div class="card-body d-grid gap-2">
                <a href="/super-admin/users" class="btn btn-primary">User Management</a>
                <a href="/super-admin/roles" class="btn btn-outline-primary">Roles & Permissions</a>
                <a href="/super-admin/settings" class="btn btn-outline-primary">System Settings</a>
                <a href="/super-admin/audit" class="btn btn-outline-primary">Audit Logs</a>
              </div>
            </div>

            <div class="card-custom mt-4">
              <div class="card-header">System Health</div>
              <div class="card-body">
                <p class="text-success mb-2"><i class="bi bi-check-circle-fill me-2"></i>Database Connected</p>
                <p class="text-success mb-2"><i class="bi bi-check-circle-fill me-2"></i>Server Running</p>
                <p class="text-success mb-0"><i class="bi bi-check-circle-fill me-2"></i>Authentication Active</p>
              </div>
            </div>
          </div>

          <div class="col-lg-8">
            <div class="card-custom">
              <div class="card-header">Recent Activities</div>
              <div class="card-body">
                <% if (activities.length === 0) { %>
                  <div class="text-center text-muted py-4">No recent activities found.</div>
                <% } else { %>
                  <% activities.forEach(activity => { %>
                    <div class="activity-item border-bottom pb-3 mb-3">
                      <strong><%= activity.title %></strong><br>
                      <small class="text-muted"><%= activity.time %></small>
                      <p class="mb-0 mt-2"><%= activity.detail %></p>
                    </div>
                  <% }) %>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>

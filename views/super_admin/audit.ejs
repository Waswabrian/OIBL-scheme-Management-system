<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Audit Logs</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    :root {
      --primary: #123d6b;
      --sidebar: #0f172a;
      --card-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
      --muted: #6b7280;
    }

    body {
      margin: 0;
      background: #f4f7fb;
      font-family: "Segoe UI", sans-serif;
      color: #1f2937;
    }

    .sidebar {
      background: var(--sidebar);
      min-height: 100vh;
      width: 260px;
      position: sticky;
      top: 0;
    }

    .sidebar .brand {
      display: flex;
      justify-content: center;
      padding: 1rem 1.25rem 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .sidebar .brand img { width: 150px; }

    .sidebar nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0.9rem 1.25rem;
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      font-weight: 500;
    }

    .sidebar nav a:hover,
    .sidebar nav a.active {
      background: rgba(255,255,255,0.08);
      color: #fff;
    }

    .main-panel { flex: 1; }

    .topbar {
      background: linear-gradient(90deg, var(--primary) 0%, #1b4d82 100%);
      color: white;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: var(--card-shadow);
    }

    .topbar h2 {
      margin: 0;
      font-size: 1.6rem;
      font-weight: 700;
    }

    .user-pill {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 999px;
      padding: 0.5rem 0.9rem;
      font-weight: 600;
    }

    .content-wrap { padding: 2rem; }

    .panel-card {
      background: white;
      border-radius: 18px;
      border: 1px solid rgba(17,24,39,0.06);
      box-shadow: var(--card-shadow);
      overflow: hidden;
    }

    .panel-card .card-header {
      background: #edf4ff;
      color: var(--primary);
      border-bottom: 1px solid rgba(18,61,107,0.08);
      padding: 1rem 1.25rem;
      font-weight: 700;
    }

    .panel-card .card-body { padding: 1.2rem; }

    .table th {
      background: #f8fafc;
      color: var(--primary);
      font-weight: 700;
    }

    @media (max-width: 768px) {
      .sidebar { width: 100%; min-height: auto; position: relative; }
      .content-wrap { padding: 1rem; }
      .topbar { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    }
  </style>
</head>
<body>
  <div class="d-flex flex-column flex-md-row">
    <aside class="sidebar">
      <div class="brand">
        <img src="/images/OCTAGON-LOGO.png" alt="OIBL Logo" />
      </div>
      <nav>
        <a href="/super-admin-dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="/super-admin/users"><i class="bi bi-people-fill"></i> Users</a>
        <a href="/super-admin/roles"><i class="bi bi-shield-lock-fill"></i> Roles</a>
        <a href="/super-admin/audit" class="active"><i class="bi bi-journal-text"></i> Audit Logs</a>
        <a href="/super-admin/settings"><i class="bi bi-gear-fill"></i> Settings</a>
        <a href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
      </nav>
    </aside>

    <main class="main-panel">
      <div class="topbar">
        <h2>Audit Logs</h2>
        <span class="user-pill">Welcome, <%= user.full_name %></span>
      </div>

      <div class="content-wrap">
        <div class="panel-card shadow-sm">
          <div class="card-header">System Activity History</div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-striped align-middle">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>User</th>
                    <th>Activity</th>
                    <th>Description</th>
                  </tr>
                </thead>
                <tbody>
                  <% logs.forEach(log => { %>
                    <tr>
                      <td><%= log.created_at %></td>
                      <td><%= log.user_name || 'System' %></td>
                      <td><%= log.title %></td>
                      <td><%= log.detail %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>

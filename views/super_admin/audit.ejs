<div class="container-fluid py-4">

<h2>Audit Logs</h2>

<div class="card shadow-sm">

<div class="card-body">

<table class="table table-striped">

<thead>
<tr>
<th>Date</th>
<th>User</th>
<th>Activity</th>
<th>Description</th>
</tr>
</thead>

<tbody>

<% logs.forEach(log => { %>

<tr>

<td><%= log.created_at %></td>

<td><%= log.user_name %></td>

<td><%= log.title %></td>

<td><%= log.detail %></td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</div>

</div>
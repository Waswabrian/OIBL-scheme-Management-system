<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Schemes | OIBL</title>
    <link rel="stylesheet" href="/styles.css" />
    <style>
      body {
        background: #f4f7fb;
        margin: 0;
        font-family: "Segoe UI", sans-serif;
      }
      .container {
        width: min(1200px, 92%);
        margin: 0 auto;
      }
      .topbar {
        background: #123d6b;
        color: #fff;
        padding: 16px 0;
      }
      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .brand img {
        height: 42px;
      }
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .role-badge {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
      }
      .page-wrap {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 24px;
        padding: 32px 0;
      }
      .sidebar,
      .panel {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
      }
      .sidebar {
        padding: 20px;
      }
      .sidebar h3 {
        color: #123d6b;
        margin-bottom: 16px;
      }
      .sidebar ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 10px;
      }
      .sidebar a {
        display: block;
        padding: 10px 12px;
        border-radius: 8px;
        background: #f3f7ff;
        color: #123d6b;
        text-decoration: none;
        font-weight: 600;
      }
      .content {
        display: grid;
        gap: 24px;
      }
      .panel {
        padding: 22px;
      }
      .panel h2 {
        color: #123d6b;
        margin-bottom: 16px;
      }
      .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 16px;
      }
      .stat-box {
        background: linear-gradient(135deg, #eef5ff, #f8fbff);
        border: 1px solid #dfeafc;
        border-radius: 10px;
        padding: 16px;
      }
      .stat-box span {
        display: block;
        color: #567;
        margin-bottom: 8px;
      }
      .stat-box strong {
        font-size: 26px;
        color: #123d6b;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        text-align: left;
        padding: 12px 10px;
        border-bottom: 1px solid #e6edf7;
      }
      th {
        color: #123d6b;
        background: #f5f8fd;
      }
      .status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
      }
      .status.action { background: #fff3cd; color: #8a6d00; }
      .status.lost { background: #ea1111; color: #100909; }
      .status.Onboarding { background: #e8edf6; color: #475467; }
      .status.Pending_Renewal { background: #eeea1f; color: #78350f; }
      .status.Renewed { background: #5eb2f3; color: #1e3a8a; }
      .status.Active { background: #4ae877; color: #1e3a8a; }
      .btn {
        display: inline-block;
        background: #f7941d;
        color: #fff;
        text-decoration: none;
        border-radius: 8px;
        padding: 10px 14px;
        font-weight: 600;
      }
      @media (max-width: 900px) {
        .page-wrap { grid-template-columns: 1fr; }
        .cards { grid-template-columns: 1fr; }
      }
    </style>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="staff-portal-page">
    <%- include('../partials/staff_topbar') %>

    <main class="container page-wrap">
      <%- include('../partials/staff_sidebar') %>

      <section class="content">
        <div class="panel">
          <h2>My Schemes</h2>
          <div class="cards">
            <div class="stat-box">
              <span>Assigned schemes</span>
              <strong><%= schemes.length %></strong>
            </div>
            <div class="stat-box">
              <span>Pending Renewal</span>
              <strong><%= schemes.filter(s => s.status === 'Pending_Renewal').length %></strong>
            </div>
            <div class="stat-box">
              <span>Active</span>
              <strong><%= schemes.filter(s => s.status === 'Active').length %></strong>
            </div>
          </div>
        </div>

        <div class="panel">
          <h2>Scheme Records</h2>
          <div class="table-scroll">
          <table class="staff-work-table">
            <thead>
              <tr>
                <th>Scheme</th>
                <th>Insurer</th>
                <th>Policy Type</th>
                <th>Premium</th>
                <th>Inception</th>
                <th>Work period</th>
                <th>Status</th>
                <th>Allocated</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (schemes && schemes.length) { %>
                <% schemes.forEach((scheme) => { %>
                  <tr>
                    <td><strong><%= scheme.scheme_name || 'Unnamed scheme' %></strong></td>
                    <td><%= scheme.insurer || '—' %></td>
                    <td><%= scheme.policy_type || '—' %></td>
                    <td><%= scheme.premium ? `KES ${Number(scheme.premium).toLocaleString()}` : '—' %></td>
                    <td><%= scheme.inception_date || '—' %></td>
                    <td><%= scheme.start_date || scheme.end_date ? `${scheme.start_date || '—'} to ${scheme.end_date || '—'}` : '—' %></td>
                    <td><span class="status <%= (scheme.status || 'onboarding').toLowerCase().replace(/\s+/g, '-') %>"><%= scheme.status || 'Onboarding' %></span></td>
                    <td><%= scheme.allocated_at ? new Date(scheme.allocated_at).toLocaleDateString() : '—' %></td>
                    <td><a class="btn" href="/staff/schemes/<%= scheme.scheme_id %>/edit">Update</a></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="9">No allocated schemes yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

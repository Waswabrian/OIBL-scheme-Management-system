<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | OIBL Schemes</title>
    <link rel="stylesheet" href="/styles.css" />
    <style>
      :root {
        --dashboard-bg: #f4f7fb;
        --dashboard-panel: rgba(255, 255, 255, 0.9);
        --dashboard-border: rgba(13, 72, 127, 0.12);
        --dashboard-primary: #0d4c8d;
        --dashboard-orange: #f59e0b;
        --dashboard-text: #17324b;
        --dashboard-muted: #5a6f86;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(180deg, #f7fafe 0%, #edf4ff 100%);
        color: var(--dashboard-text);
      }

      .topbar {
        /* position: sticky; */
        top: 0;
        z-index: 10;
        background: rgba(140, 194, 227, 0.88);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .dashboard-main {
        padding: 40px 0 56px;
      }

      .dashboard-sidebar,
      .panel,
      .stat-card,
      .info-box {
        background: var(--dashboard-panel);
        border: 1px solid var(--dashboard-border);
        box-shadow: 0 14px 30px rgba(10, 42, 71, 0.05);
      }

      .dashboard-sidebar a {
        color: var(--dashboard-muted);
        font-weight: 600;
      }

      .dashboard-sidebar a:hover {
        color: var(--dashboard-primary);
      }

      .role-badge {
        background: rgba(13, 76, 141, 0.08);
        color: var(--dashboard-primary);
      }

      .role-admin {
        background: rgba(245, 158, 11, 0.12);
        color: #a25a00;
      }

      .panel h2,
      .stat-card strong,
      .info-box strong,
      .welcome-text {
        color: var(--dashboard-text);
      }

      .activity-list {
        color: var(--dashboard-muted);
        line-height: 1.8;
      }

      .activity-list li {
        margin-bottom: 10px;
      }

      textarea {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }
    </style>
    <script>
      function updateProfile() {
        const bio = document.getElementById('profileBio').value;
        fetch('/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bio })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('Profile updated successfully!');
          } else {
            alert('Error: ' + (data.error || 'Unable to update profile'));
          }
        })
        .catch(err => alert('Error: ' + err.message));
      }
    </script>
  </head>
  <body>
    <%- include('../partials/admin_nav') %>

    <main class="dashboard-main">
      <div class="container dashboard-grid">
        <%- include('../partials/admin_side_nav') %>

        <section class="dashboard-content">
          <div class="panel" style="margin-bottom: 30px; padding: 20px;">
            <h3 style="margin-top: 0; color: #0d4c8d; font-size: 18px;">Your Profile</h3>
            <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 20px; align-items: start;">
              <div>
                <p style="margin: 0 0 5px 0; color: #5a6f86; font-size: 12px; text-transform: uppercase;">Name</p>
                <p style="margin: 0; color: #17324b; font-weight: 600;"><%= profile.full_name %></p>
                <p style="margin: 10px 0 5px 0; color: #5a6f86; font-size: 12px; text-transform: uppercase;">Email</p>
                <p style="margin: 0; color: #17324b;"><%= profile.email %></p>
              </div>
              <div>
                <label style="display: block; color: #5a6f86; font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">Bio</label>
                <textarea id="profileBio" style="width: 100%; padding: 10px; border: 1px solid #d9e2ec; border-radius: 6px; font-size: 14px; resize: vertical; min-height: 80px;" placeholder="Tell us about yourself..."><%= profile.bio || '' %></textarea>
                <button onclick="updateProfile()" style="margin-top: 10px; padding: 8px 16px; background: #0d4c8d; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">Save Profile</button>
              </div>
            </div>
          </div>
          <div class="dashboard-cards">
            <div class="stat-card">
              <span>Total schemes</span>
              <strong><%= stats && stats.totalSchemes !== undefined ? stats.totalSchemes : 0 %></strong>
            </div>
            <div class="stat-card">
              <span>Allocated schemes</span>
              <strong><%= stats && stats.pendingSchemes !== undefined ? stats.pendingSchemes : 0 %></strong>
            </div>
            <div class="stat-card">
              <span>Claims</span>
              <strong><%= stats && stats.approvedSchemes !== undefined ? stats.approvedSchemes : 0 %></strong>
            </div>
          </div>

          <div class="panel">
            <h2>Operations summary</h2>
            <div class="info-grid">
              <div class="info-box">
                <small>Active staff</small>
                <strong><%= stats && stats.staffCount !== undefined ? stats.staffCount : 0 %></strong>
              </div>
              <div class="info-box">
                <small>Needs attention</small>
                <strong>6 requests</strong>
              </div>
              <div class="info-box">
                <small>Funding status</small>
                <strong>Healthy</strong>
              </div>
              <div class="info-box">
                <small>Last sync</small>
                <strong>9:15 AM</strong>
              </div>
            </div>
          </div>

          <div class="panel">
            <h2>Recent admin activity</h2>
            <ul class="activity-list">
              <% if (activities && activities.length) { %>
                <% activities.forEach((activity) => { %>
                  <li>
                    <strong><%= activity.title %></strong><br />
                    <span><%= activity.detail %></span><br />
                    <small><%= activity.time %></small>
                  </li>
                <% }) %>
              <% } else { %>
                <li>No recent activity recorded.</li>
              <% } %>
            </ul>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Admin Dashboard' %></title>

    <style>
        :root{
            --dashboard-bg:#f4f7fb;
            --dashboard-panel:#ffffff;
            --dashboard-border:rgba(13,72,127,.12);
            --dashboard-primary:#0d4c8d;
            --dashboard-text:#17324b;
            --dashboard-muted:#5a6f86;
        }

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif;
            background:linear-gradient(180deg,#f7fafe 0%,#edf4ff 100%);
            color:var(--dashboard-text);
        }

        .dashboard-main{
            padding:30px;
        }

        .container{
            max-width:1400px;
            margin:auto;
        }

        .dashboard-grid{
            display:grid;
            grid-template-columns:260px 1fr;
            gap:24px;
            align-items:start;
        }

        .dashboard-content{
            width:100%;
        }

        .dashboard-header{
            background:linear-gradient(135deg,#2563eb,#1e40af);
            color:white;
            padding:30px;
            border-radius:20px;
            margin-bottom:25px;
            box-shadow:0 10px 30px rgba(37,99,235,.25);
        }

        .dashboard-header h2{
            font-size:2rem;
            margin-bottom:8px;
        }

        .dashboard-header p{
            opacity:.9;
        }

        .stats-grid{
            display:grid;
            grid-template-columns:repeat(4,1fr);
            gap:20px;
            margin-bottom:25px;
        }

        .stat-card{
            background:var(--dashboard-panel);
            border:1px solid var(--dashboard-border);
            border-radius:18px;
            padding:25px;
            box-shadow:0 14px 30px rgba(10,42,71,.05);
            transition:.3s;
        }

        .stat-card:hover{
            transform:translateY(-4px);
        }

        .stat-title{
            font-size:12px;
            text-transform:uppercase;
            color:var(--dashboard-muted);
            letter-spacing:1px;
        }

        .stat-value{
            margin-top:12px;
            font-size:34px;
            font-weight:700;
            color:var(--dashboard-primary);
        }

        .section-card{
            background:white;
            border:1px solid var(--dashboard-border);
            border-radius:18px;
            padding:24px;
            margin-bottom:25px;
            box-shadow:0 14px 30px rgba(10,42,71,.05);
        }

        .section-card h5{
            margin-bottom:20px;
            color:var(--dashboard-primary);
            font-size:18px;
        }

        .table-responsive{
            overflow-x:auto;
        }

        table{
            width:100%;
            border-collapse:collapse;
        }

        table th{
            background:#eef4fc;
            color:var(--dashboard-primary);
            text-align:left;
            padding:12px;
            border-bottom:1px solid #dbe5f1;
        }

        table td{
            padding:12px;
            border-bottom:1px solid #edf1f5;
        }

        table tr:hover{
            background:#f8fbff;
        }

        .badge{
            padding:6px 12px;
            border-radius:20px;
            font-size:12px;
            font-weight:600;
        }

        .bg-success{
            background:#dcfce7;
            color:#166534;
        }

        .bg-danger{
            background:#fee2e2;
            color:#991b1b;
        }

        .bg-warning{
            background:#fef3c7;
            color:#92400e;
        }

        .bg-secondary{
            background:#e5e7eb;
            color:#374151;
        }
.dashboard-grid{
    display:grid;
    grid-template-columns:260px 1fr;
    gap:24px;
    align-items:start;
}

.dashboard-sidebar{
    background:var(--dashboard-panel);
    border:1px solid var(--dashboard-border);
    border-radius:20px;
    padding:20px;
    min-height:calc(100vh - 120px);
    box-shadow:0 14px 30px rgba(10,42,71,.05);
}

.dashboard-sidebar h3{
    color:var(--dashboard-text);
    margin-bottom:0px;
}

.dashboard-sidebar ul{
    list-style:none;
    margin:0;
    padding:0;
}

.dashboard-sidebar li{
    margin-bottom:0px;
}

.dashboard-sidebar a{
    display:block;
    padding:10px 10px;
    border-radius:12px;
    color:var(--dashboard-muted);
    text-decoration:none;
    font-weight:600;
    transition:all .3s ease;
}

.dashboard-sidebar a:hover,
.dashboard-sidebar a.active{
    background:rgba(13,76,141,.08);
    color:var(--dashboard-primary);
}

.dashboard-content{
    width:100%;
    padding:20px;
}
 .topbar {
            /* position: sticky; */
    top: 0;
    z-index: 10;
    background: rgba(140, 194, 227, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    
    
    }
    .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 70px;
        height: 80px;   
        }
.brand img {
  height: 52px;
  width: auto;
  display: block;
  filter: drop-shadow(0 4px 8px rgba(11, 74, 155, 0.08));
}
.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  font-size: 1.1rem;
  box-shadow: var(--shadow);
}

    .container {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        }


        @media(max-width:992px){

            .dashboard-grid{
                grid-template-columns:1fr;
            }

            .stats-grid{
                grid-template-columns:repeat(2,1fr);
            }

            .dashboard-header h2{
                font-size:1.6rem;
            }
        }

        @media(max-width:768px){

            .stats-grid{
                grid-template-columns:1fr;
            }

            .dashboard-main{
                padding:15px;
            }
        }
       
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <%- include('../partials/admin_nav') %>

    <main class="dashboard-main">
        <div class="container">

            <div class="dashboard-grid">

                <!-- SIDEBAR -->
                <%- include('../partials/admin_side_nav') %>

                <!-- CONTENT -->
                <section class="dashboard-content">

                    <div class="dashboard-header">
                        <h2>Business Development Dashboard</h2>
                        <p>
                            Performance overview of prospects, schemes and premium growth.
                        </p>
                    </div>

                    <div class="stats-grid">

                        <div class="stat-card">
                            <div class="stat-title">Total Prospects</div>
                            <div class="stat-value">
                                <%= stats.prospects || 0 %>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-title">Total Schemes</div>
                            <div class="stat-value">
                                <%= stats.schemes || 0 %>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-title">Pipeline Value</div>
                            <div class="stat-value">
                                KES <%= Number(stats.pipeline || 0).toLocaleString() %>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-title">Won Premium</div>
                            <div class="stat-value">
                                KES <%= Number(stats.premium || 0).toLocaleString() %>
                            </div>
                        </div>

                    </div>

                    <!-- BDO LEADERBOARD -->
                    <div class="section-card">
                        <h5>🏆 BDO Leaderboard</h5>

                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th>BDO</th>
                                        <th>Prospects</th>
                                        <th>Schemes</th>
                                        <th>Premium</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% leaderboard.forEach(item => { %>
                                    <tr>
                                        <td><strong><%= item.full_name %></strong></td>
                                        <td><%= item.prospects %></td>
                                        <td><%= item.schemes %></td>
                                        <td>KES <%= Number(item.premium || 0).toLocaleString() %></td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- RECENT PROSPECTS -->
                    <div class="section-card">
                        <h5>📌 Recent Prospects</h5>

                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Company</th>
                                        <th>Stage</th>
                                        <th>Premium</th>
                                        <th>BDO</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% prospects.forEach(prospect => { %>
                                    <tr>
                                        <td><%= prospect.company_name %></td>

                                        <td>
                                            <% if(prospect.stage === 'Won'){ %>
                                                <span class="badge bg-success">Won</span>
                                            <% } else if(prospect.stage === 'Lost'){ %>
                                                <span class="badge bg-danger">Lost</span>
                                            <% } else { %>
                                                <span class="badge bg-warning">
                                                    <%= prospect.stage %>
                                                </span>
                                            <% } %>
                                        </td>

                                        <td>
                                            KES <%= Number(prospect.estimated_premium || 0).toLocaleString() %>
                                        </td>

                                        <td>
                                            <%= prospect.bdo_name || '-' %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- RECENT ACTIVITY -->
                    <div class="section-card">
                        <h5>📝 Recent Activity</h5>

                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Company</th>
                                        <th>Stage</th>
                                        <th>Follow Up</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% recentActivities.forEach(activity => { %>
                                    <tr>
                                        <td><%= activity.company_name %></td>
                                        <td><%= activity.stage %></td>
                                        <td>
                                            <%= activity.follow_up_date ? new Date(activity.follow_up_date).toLocaleDateString() : '-' %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </section>

            </div>

        </div>
    </main>

</body>
</html>